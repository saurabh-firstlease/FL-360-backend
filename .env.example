# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/fl_tours

# Long random string. Required for every /api/admin/* request (Authorization: Bearer <token>).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Public URL of this API. Used to build image URLs in responses.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Where uploaded panoramas and floor plans are stored.
MEDIA_ROOT=./media

# Upload limits
MAX_UPLOAD_MB=60
PANO_FULL_WIDTH=4096
